rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Listing images: food_items/{merchantUid}/{file}
    match /food_items/{merchantUid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == merchantUid;
    }

    // Profile photos: users/{uid}/... (written by [AuthService.updateProfileImageFromBytes])
    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Paths that do not match the rules above are denied by default (no catch‑all:
    // a global `allow read, write: if false` also matches users/ and food_items/ and
    // would block every request — Firebase ANDs all matching rules).
  }
}
