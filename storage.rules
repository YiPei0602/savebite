rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Food listing images live under: food_items/{merchantUid}/{itemId}.{ext}
    // Read: any signed-in user
    // Write: only the owner (merchantUid must match auth uid)
    match /food_items/{merchantUid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == merchantUid;
    }
  }
}

