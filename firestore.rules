rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function isMerchant() {
      return hasUserDoc() && userDoc().data.role == 'merchant';
    }

    function isAdmin() {
      return (hasUserDoc() && userDoc().data.role == 'admin')
        || (
          signedIn()
          && request.auth.token.email != null
          && request.auth.token.email in [
            'admin@gmail.com'
          ]
        );
    }

    function ownsMerchantId(merchantId) {
      return signedIn()
        && (
          merchantId == request.auth.uid
          || (
            isMerchant()
            && userDoc().data.merchantId != null
            && merchantId == userDoc().data.merchantId
          )
        );
    }

    function isOrderBuyer() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    /// Buyers may mark their own pickup order collected once the merchant marks it ready.
    function buyerCollectsPickupOrder() {
      return isOrderBuyer()
        && resource.data.fulfillmentType == 'pickup'
        && resource.data.orderStatus == 'ready'
        && request.resource.data.orderStatus == 'completed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.merchantId == resource.data.merchantId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            'orderStatus',
            'updatedAt',
            'completedAt'
          ]);
    }

    /// Buyers may cancel their own early-stage orders; fulfillment progress is merchant-driven.
    function buyerCancelsOrderOnly() {
      return isOrderBuyer()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.merchantId == resource.data.merchantId
        && resource.data.orderStatus in ['pending', 'confirmed']
        && request.resource.data.orderStatus == 'cancelled'
        && request.resource.data.cancellationReason == 'buyerRequested'
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            'orderStatus',
            'updatedAt',
            'completedAt',
            'cancellationReason'
          ]);
    }

    /// Consumer checkout decrements physical stock / reserved aggregates (see OrderService).
    function checkoutFoodCountersOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['stock', 'reservedStock', 'updatedAt'])
        && request.resource.data.merchantId == resource.data.merchantId
        && request.resource.data.stock is int
        && request.resource.data.reservedStock is int
        && request.resource.data.stock >= 0
        && request.resource.data.reservedStock >= 0
        && request.resource.data.stock <= resource.data.stock
        && request.resource.data.reservedStock <= request.resource.data.stock;
    }

    /// Clients cannot set or clear sustainability impact bookkeeping (Cloud Function only).
    function orderSustainabilityBookkeepingUntouched() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny([
        'sustainabilityImpactApplied',
        'sustainabilityImpactAppliedAt'
      ]);
    }

    // Users manage their own doc; merchants may read buyer profiles for fulfillment.
    match /users/{userId} {
      allow read, create: if signedIn() && (
        isAdmin()
        || 
        request.auth.uid == userId
        || isMerchant()
      );

      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'impactData'
          ])
        )
      );

      allow delete: if signedIn() && (isAdmin() || request.auth.uid == userId);
    }

    match /merchants/{merchantId} {
      allow read: if signedIn();
      allow create: if signedIn() && merchantId == request.auth.uid;
      allow update, delete: if ownsMerchantId(merchantId);
    }

    match /food_items/{itemId} {
      allow read: if signedIn();
      allow create: if ownsMerchantId(request.resource.data.merchantId);
      allow update, delete: if ownsMerchantId(resource.data.merchantId)
        || checkoutFoodCountersOnly();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (
        isAdmin()
        ||
        resource.data.userId == request.auth.uid
        || ownsMerchantId(resource.data.merchantId)
      );
      allow update: if signedIn() && (
        (ownsMerchantId(resource.data.merchantId)
          && orderSustainabilityBookkeepingUntouched())
        || buyerCancelsOrderOnly()
        || buyerCollectsPickupOrder()
      );
      allow delete: if false;
    }

    match /stock_reservations/{reservationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
