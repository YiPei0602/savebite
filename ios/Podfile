platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  raise "#{generated_xcode_build_settings_path} must exist" unless File.exist?(generated_xcode_build_settings_path)

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# ✅ REQUIRED for Firebase + gRPC (Xcode 26 SAFE)
use_frameworks! :linkage => :static

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # geocoding_ios (and similar pods) can list PrivacyInfo.xcprivacy under
    # Compile Sources; Xcode has no rule → "Could not build". Only resources
    # should bundle it. (Aggregate targets have no source_build_phase.)
    next unless target.respond_to?(:source_build_phase)

    target.source_build_phase.files.to_a.each do |file|
      ref = file.file_ref
      path = ref&.path || ref&.real_path&.to_path
      target.source_build_phase.files.delete(file) if path&.end_with?('.xcprivacy')
    end

    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # ✅ Apple Silicon simulator fix
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'

      # ✅ Prevent gRPC modulemap breakage
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
    end
  end

  # Match Runner to pods: if pods skip x86_64 simulator, Runner must too or
  # `generic/platform=iOS Simulator` builds x86_64 and @import cloud_firestore fails.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      next unless target.name == 'Runner'

      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      end
    end
    aggregate_target.user_project.save
  end
end
